# Backend Environment Configuration Example
# Copy to .env or set these in your hosting dashboard (e.g. MonsterASP / Render)

PORT=10000
SUPABASE_CONNECTION_STRING=Host=your-project.pooler.supabase.com;Port=5432;Database=postgres;Username=your_user;Password=your_password;SSL Mode=Require;Trust Server Certificate=true
Jwt__Key=your-very-strong-secret-key-at-least-32-chars-long
Jwt__Issuer=CallMeProf
Jwt__Audience=CallMeProfApp
FRONTEND_URL=http://localhost:4200,https://profblog.me,https://www.profblog.me,https://elprof-blog.vercel.app
ADMIN_PASSWORD=your-secure-admin-password
ADMIN_EDITOR_PASSWORD=your-secure-editor-password
SESSION_SECRET=your-secure-session-signing-secret
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_BUCKET=blog-images
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
